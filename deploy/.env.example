# Salin menjadi deploy/.env (tidak masuk git), lalu isi.
POSTGRES_PASSWORD=ganti-dengan-password-acak
# Folder peta di mesin host (hasil spike/run.py --out ...). Dipasang ke container sebagai /maps.
EUTOPOS_MAPS_DIR=/home/USER/eutopos-data/maps
EUTOPOS_AREA=demo
EUTOPOS_PORT=8000
EUTOPOS_THREADS=0
EUTOPOS_GLOBAL_RESIZE=512
# Folder data pekerja di host WSL (frame, log, nanti unggahan website). Harus sudah ada dan
# dimiliki uid 1000 (pengguna WSL pertama, sama dengan pengguna di container).
EUTOPOS_DATA_DIR=/home/USER/eutopos-data/work
# Cloudflare Access (PR 4). Tanpa keduanya, /api/* dan unggahan menjawab 503 (gagal tertutup).
# Isi di deploy/.env saja, jangan pernah di repo. Domain tim berbentuk https://<team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# 1 = tanpa autentikasi, HANYA untuk uji dari dalam PC lab sebelum Tunnel ada. Diabaikan kalau
# CF_ACCESS_* terisi.
EUTOPOS_DEV_NO_AUTH=0
# Email admin dipisah koma, boleh menghapus job di dashboard. Kosong = tidak ada yang boleh
# (gagal tertutup). Pengguna lain yang lolos Access hanya bisa melihat.
EUTOPOS_ADMINS=
# Rahasia kanal hook tusd -> api, wajib. Buat dengan: openssl rand -hex 32
TUS_HOOK_SECRET=
# Cloudflare Tunnel (compose.tunnel.yaml). RAHASIA, jangan pernah di repo atau di chat.
TUNNEL_TOKEN=
# Supaya "docker compose up -d" langsung memakai semua berkas (PC lab dengan GPU dan Tunnel):
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml:compose.tunnel.yaml
