# Salin menjadi deploy/.env (tidak masuk git), lalu isi.
POSTGRES_PASSWORD=ganti-dengan-password-acak
# Folder peta di mesin host (hasil spike/run.py --out ...). Dipasang ke container sebagai /maps.
EUTOPOS_MAPS_DIR=/home/USER/eutopos-data/maps
EUTOPOS_AREA=demo
EUTOPOS_PORT=8000
EUTOPOS_THREADS=0
EUTOPOS_GLOBAL_RESIZE=512
