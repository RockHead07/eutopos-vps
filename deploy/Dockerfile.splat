# syntax=docker/dockerfile:1
# Image layanan pekerja splat otomatis (gsplat 1.5.3 + splat-transform + server.splat_worker).
# Memuat dua environment Python:
#   1. /opt/conda/bin/python: Python 3.11 conda untuk pelatih gsplat (pycolmap fork rmbrualla, numpy<2).
#   2. /opt/venv/bin/python: Python 3.12 venv untuk layanan dan alat (pycolmap resmi 4.2.1, numpy 2.5.2).

# pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel@sha256:a55ff10111eb11f998884327d37361592e632899edd24fce99886b69289e33e6

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="8.6" \
    TORCH_EXTENSIONS_DIR=/opt/torch_extensions \
    MAX_JOBS=4 \
    PIP_NO_CACHE_DIR=1

# Pustaka sistem dasar untuk gsplat. Daftar paket dan perintahnya SAMA PERSIS dengan ~/splat/Dockerfile
# terbukti: jangan menambah paket di sini, karena mengubah baris ini membatalkan cache semua lapisan
# pelatih di bawahnya (±11 menit membangun ulang, terukur di build2.log). Paket tambahan di lapisan sendiri.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/torch_extensions && chmod -R a+rwX /opt/torch_extensions

# Lapisan pelatih gsplat 1.5.3 (identik dengan image terbukti eutopos-splat:local)
RUN git clone --branch v1.5.3 --depth 1 https://github.com/nerfstudio-project/gsplat /opt/gsplat

WORKDIR /opt/gsplat

RUN pip install --no-cache-dir gsplat==1.5.3

RUN pip install --no-cache-dir --no-build-isolation -r examples/requirements.txt

WORKDIR /opt/gsplat/examples

RUN python -c "import gsplat; print(gsplat.__file__); from gsplat.cuda._backend import _C; print('JIT OK')"

# curl hanya untuk mengunduh bobot saat BUILD; lapisan terpisah di atas lapisan pelatih yang di-cache.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Cache bobot AlexNet lokal untuk evaluasi LPIPS (tanpa unduhan saat runtime)
RUN mkdir -p /opt/torch_home/hub/checkpoints && \
    curl -fsSL -o /opt/torch_home/hub/checkpoints/alexnet-owt-7be5be79.pth \
      https://download.pytorch.org/models/alexnet-owt-7be5be79.pth && \
    echo "7be5be791159472b1fbf3c69796f7cb30dca7ad8466c2df70058c37116cdee02  /opt/torch_home/hub/checkpoints/alexnet-owt-7be5be79.pth" | sha256sum -c - && \
    chmod -R a+rX /opt/torch_home

ENV TORCH_HOME=/opt/torch_home

# Node.js 22 dan @playcanvas/splat-transform untuk konversi SOG
# node:22-slim
COPY --from=node:22-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    mkdir -p /opt/splat-transform && \
    cd /opt/splat-transform && \
    npm install --no-audit --no-fund @playcanvas/splat-transform@3.10.3 && \
    chmod -R a+rX /opt/splat-transform

# Python 3.12 dan venv layanan (/opt/venv) via uv
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python

RUN uv python install 3.12 && chmod -R a+rX /opt/uv-python

RUN uv venv --python 3.12 /opt/venv && /opt/venv/bin/python --version

WORKDIR /app
COPY pyproject.toml uv.lock ./

RUN uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/requirements.txt && \
    echo "pycolmap==4.2.1" >> /tmp/requirements.txt && \
    echo "numpy==2.5.2" >> /tmp/requirements.txt && \
    echo "scipy==1.18.1" >> /tmp/requirements.txt && \
    echo "Pillow==12.3.0" >> /tmp/requirements.txt && \
    uv pip install --python /opt/venv -r /tmp/requirements.txt && \
    rm -f /tmp/requirements.txt && \
    chmod -R a+rX /opt/venv

# Pengguna sistem eutopos (UID 1000 sama dengan pekerja worker)
RUN useradd -u 1000 -m -s /bin/bash eutopos

COPY server/ /app/server/
COPY spike/ /app/spike/
RUN chown -R eutopos:eutopos /app

USER eutopos
ENV HOME=/home/eutopos

# PATH: venv layanan di depan; sisanya tetap PATH image dasar (cuda, nvidia, conda untuk ninja dan pelatih)
ENV PATH=/opt/venv/bin:${PATH}

CMD ["/opt/venv/bin/python", "-m", "server.splat_worker"]
