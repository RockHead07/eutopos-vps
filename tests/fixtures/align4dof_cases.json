{
  "about": "Parity test cases between server/align4dof.py and eutopos-mobile Aligner4Dof.Solve + FrameConvert. Units: metres for all positions/translations, degrees wrapped to [-180, 180) for yaw_deg. Frames: building_position_g and building_rotation_xyzw are in server building frame G (right-handed, Z-up; camera optical axis is +Z_cam rotated by building_rotation_xyzw, then converted to Unity building frame B by swapping Y and Z); ar_position and ar_rotation_xyzw are in Unity AR session frame U (left-handed, Y-up; camera forward is +Z rotated by ar_rotation_xyzw). Quaternions are [x, y, z, w] (xyzw). Expected 4-DoF alignment maps B to U via p_U = RotY(yaw_deg) * p_B + translation, or null when either camera forward horizontal fraction is < 0.3.",
  "cases": [
    {
      "name": "identity_origin",
      "ar_position": [
        0.0,
        1.3,
        0.0
      ],
      "ar_rotation_xyzw": [
        0.0,
        0.0,
        0.0,
        1.0
      ],
      "building_position_g": [
        0.0,
        0.0,
        1.3
      ],
      "building_rotation_xyzw": [
        -0.70710678,
        -0.0,
        -0.0,
        0.70710678
      ],
      "expected": {
        "yaw_deg": 0.0,
        "translation": [
          0.0,
          0.0,
          0.0
        ]
      }
    },
    {
      "name": "pure_translation",
      "ar_position": [
        3.5,
        1.4,
        -2.25
      ],
      "ar_rotation_xyzw": [
        0.0,
        0.0,
        0.0,
        1.0
      ],
      "building_position_g": [
        1.0,
        2.0,
        1.3
      ],
      "building_rotation_xyzw": [
        -0.70710678,
        -0.0,
        -0.0,
        0.70710678
      ],
      "expected": {
        "yaw_deg": 0.0,
        "translation": [
          2.5,
          0.1,
          -4.25
        ]
      }
    },
    {
